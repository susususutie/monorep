{
  "name": "@sutie/antd",
  "version": "1.0.0",
  "description": "UI components with React and antd",
  "type": "module",
  "main": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "pnpm run build:esm && pnpm run build:cjs && pnpm run build:dist",
    "build:esm": "rm -rf ./esm && bash ./script/copy.sh esm && tsc -p tsconfig.esm.json",
    "build:cjs": "rm -rf ./cjs && bash ./script/copy.sh cjs && tsc -p tsconfig.cjs.json",
    "build:dist": "tsc && vite build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "@emotion/css": "^11.11.2",
    "ahooks": "^3.7.8",
    "antd": "^5.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@sutie/demo": "workspace:*"
  },
  "devDependencies": {
    "@emotion/css": "^11.11.2",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.11",
    "@vitejs/plugin-react-swc": "^3.4.0",
    "ahooks": "^3.7.8",
    "antd": "^5.4.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.9.5",
    "vite": "^4.4.11",
    "@sutie/demo": "workspace:*"
  }
}
