{
  "name": "@sutie/antd",
  "version": "1.0.0",
  "description": "UI components with React and antd",
  "type": "module",
  "main": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "corepack pnpm run build:esm && corepack pnpm run build:cjs && corepack pnpm run build:dist",
    "build:esm": "rm -rf ./esm && bash ./script/copy.sh esm && tsc -p tsconfig.esm.json",
    "build:cjs": "rm -rf ./cjs && bash ./script/copy.sh cjs && tsc -p tsconfig.cjs.json",
    "build:dist": "tsc && vite build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "@emotion/css": "^11.13.0",
    "@sutie/demo": "workspace:*",
    "ahooks": "^3.8.0",
    "antd": "^5.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@emotion/css": "^11.13.0",
    "@sutie/demo": "workspace:*",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "ahooks": "^3.8.0",
    "antd": "^5.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^4.9.5",
    "vite": "^4.5.3"
  }
}
